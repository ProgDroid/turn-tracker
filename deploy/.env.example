# Copy to /opt/turn-tracker/.env on the box, fill in, then `chmod 600 .env`.
# NEVER commit the filled-in version — this repository is public.

BIND_ADDR=0.0.0.0:8080
STATIC_DIR=/home/app/static
ALLOWED_ORIGINS=https://whosego.app
TT_SNAPSHOT_PATH=/data/rooms.json
TT_SNAPSHOT_INTERVAL_SECS=60

# Closed beta only. Generate with: openssl rand -hex 16
# Room CREATION then requires a matching X-Create-Token header; joining is
# never gated. Delete this line and recreate the container to open the app to
# everyone. Leaving it empty is the same as deleting it.
TT_CREATE_TOKEN=
